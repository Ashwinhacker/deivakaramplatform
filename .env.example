# =============================================================================
# DEIVAKARAM CHARITABLE TRUST - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# Do not commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTH CONFIGURATION
# Retrieve from: Supabase Project Settings -> API (Project URL & Keys)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# SERVER-SIDE ONLY: Service Role Key for administrative backend operations
# NEVER expose this key to frontend or client code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY CONFIGURATION
# Retrieve from: Razorpay Dashboard -> Settings -> API Keys & Webhooks
# -----------------------------------------------------------------------------
# Public Key ID for browser checkout dialog (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Server-Side Credentials (used for order creation and signature verification)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# -----------------------------------------------------------------------------
# 3. TRUST DIRECT & OFFLINE PAYMENT DETAILS
# -----------------------------------------------------------------------------
VITE_TRUST_UPI_ID=ashwinop58@okicici

# -----------------------------------------------------------------------------
# 4. SERVER & RUNTIME CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5001
NODE_ENV=production
